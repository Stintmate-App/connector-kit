{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pitwall.local/connector-kit/control-state.schema.json",
  "title": "The control.state of a connector's control app",
  "description": "contract.md section 3.2: the common fields of every control app plus the fields a connector adds. Unknown fields are allowed. The state of a service is a free string: the named states of contract.md section 3.2 have a meaning there, any other is legal and shown by its label.",
  "type": "object",
  "properties": {
    "app": {"type": "string", "description": "The control app's name."},
    "pid": {"type": "integer", "description": "The control app's PID."},
    "version": {"type": "string"},
    "managed": {"type": "boolean"},
    "parent_pid": {"type": ["integer", "null"]},
    "window": {"type": "string", "enum": ["shown", "hidden"]},
    "exiting": {"type": "boolean"},
    "autostart": {"type": ["boolean", "null"], "description": "null if unreadable."},
    "level": {"type": "string", "enum": ["off", "ok", "warn", "error"], "description": "The tray colour of the app as a whole."},
    "services": {"type": "array", "items": {"$ref": "#/$defs/service"}},
    "connector": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$"},
        "name": {"type": "string"},
        "version": {"type": "string"},
        "sim": {"type": "string", "pattern": "^[a-z0-9_-]{1,32}$"},
        "sim_name": {"type": "string"}
      },
      "required": ["id", "name", "version", "sim", "sim_name"]
    },
    "game_running": {"type": "boolean"},
    "pitwall": {"type": "string", "enum": ["connected", "waiting", "refused"]},
    "outbox": {
      "type": "object",
      "properties": {
        "pending": {"type": "integer", "minimum": 0},
        "oldest_at": {"type": ["string", "null"]}
      },
      "required": ["pending", "oldest_at"]
    },
    "start_with_app": {"type": "array", "items": {"type": "string"}}
  },
  "required": ["app", "pid", "version", "window", "exiting", "level", "services",
               "connector", "game_running", "pitwall", "outbox", "start_with_app"],
  "$defs": {
    "service": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string"},
        "state": {"type": "string", "minLength": 1},
        "label": {"type": "string"},
        "level": {"type": "string", "enum": ["off", "ok", "warn", "error"]},
        "running": {"type": "boolean"},
        "ownership": {"type": "string"},
        "pid": {"type": ["integer", "null"]},
        "forced_stop": {"type": "boolean"},
        "restart_pending": {"type": "boolean"},
        "delegable": {"type": "boolean"},
        "default": {"enum": ["on", "off"]},
        "always_on": {"type": "boolean"},
        "refusal": {
          "type": ["object", "null"],
          "properties": {"code": {"type": "string"}, "label": {"type": "string"}},
          "required": ["code", "label"]
        }
      },
      "required": ["id", "name", "state", "label", "level", "running"]
    }
  }
}
